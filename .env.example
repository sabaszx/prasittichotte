HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
APP_MODE=demo
DATABASE_PATH=./data/prasittichoke.db
# Required for live mode; minimum 16 characters. Never commit real credentials.
ADMIN_PASSWORD=
COOKIE_SECURE=false
INGEST_TOKEN=
# Live mode is read-only towards Zoho unless explicitly enabled.
ZOHO_WRITE_ENABLED=false
ZOHO_API_BASE=https://desk.zoho.com/api/v1
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Exact ticket URL prefix for your tenant, e.g. https://desk.zoho.com/support/ORG/ShowHomePage.do#Cases/dv/
ZOHO_TICKET_URL_PREFIX=
# Optional HTTPS endpoint implementing the chat-completions JSON contract.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
# Enable only after approving the data sent to your model provider.
LLM_ENABLED=false
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=false
