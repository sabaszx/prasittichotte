{
  "name": "prasittichoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/domain.js && node --check src/store.js && node --check src/integrations.js && node --check public/app.js",
    "test:e2e": "playwright test"
  },
  "dependencies": { "express": "^5.1.0", "zod": "^4.0.0" },
  "devDependencies": { "@playwright/test": "^1.55.0" }
}
